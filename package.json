{
	"name": "obsidian-md-to-chm",
	"version": "1.0.0",
	"description": "Obsidian plugin that compiles notes into Compiled HTML Help (.chm) files",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node scripts/smoke.build.mjs && node scripts/smoke.cjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"chm",
		"html-help",
		"documentation"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"obsidian": "^1.7.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
